{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"strict": true,
		"lib": ["DOM", "ES6", "ES7", "ESNext"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "*.d.ts"]
}
